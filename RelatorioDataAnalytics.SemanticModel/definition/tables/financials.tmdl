	column 'Região' = SWITCH(financials[Country], "Canada", "América do Norte", "Mexico", "América do Norte", "United States of America", "América do Norte", "France", "Europa", "Germany", "Europa", "Outros")
		dataType: string
		lineageTag: ff7815dc-8da5-41b6-883c-3b2b202cd3e3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Segmento (grupo)' = SWITCH(financials[Segment], "Government", "Grandes Contas", "Enterprise", "Grandes Contas", "PMEs e Parceiros")
		dataType: string
		lineageTag: f6b024ee-f015-407d-8f20-a291cdcc6afa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Faixa de Unidades' = INT(financials[Units Sold] / 500) * 500
		dataType: int64
		formatString: #,0
		isHidden
		lineageTag: 3d5fef51-3755-4f19-9dfd-319ae3461f1a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Faixa de Unidades (rótulo)' = FORMAT(financials[Faixa de Unidades], "#,0") & " a " & FORMAT(financials[Faixa de Unidades] + 499, "#,0")
		dataType: string
		lineageTag: c7a5fa11-4738-44e5-83e9-db31142dc27e
		summarizeBy: none
		sortByColumn: 'Faixa de Unidades'

		annotation SummarizationSetBy = Automatic

	partition financials = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoArquivo), null, true),
				    financials_Table = Fonte{[Item="financials",Kind="Table"]}[Data],
				    TiposAlterados = Table.TransformColumnTypes(financials_Table, {
				        {"Segment", type text}, {"Country", type text}, {"Product", type text}, {"Discount Band", type text},
				        {"Units Sold", type number}, {"Manufacturing Price", type number}, {"Sale Price", type number},
				        {"Gross Sales", type number}, {"Discounts", type number}, {" Sales", type number},
				        {"COGS", type number}, {"Profit", type number}, {"Date", type date},
				        {"Month Number", Int64.Type}, {"Month Name", type text}, {"Year", Int64.Type}
				    }),
				    // A coluna original vem com um espaço no início (" Sales")
				    ColunasRenomeadas = Table.RenameColumns(TiposAlterados, {{" Sales", "Sales"}})
				in
				    ColunasRenomeadas

	annotation PBI_ResultType = Table
